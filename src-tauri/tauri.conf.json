{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PlasmidCraft 0.4",
  "version": "0.4.0",
  "identifier": "org.plasmidcraft.desktop",
  "build": {
    "frontendDist": "../viewer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PlasmidCraft",
        "width": 1440,
        "height": 960,
        "minWidth": 760,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Local plasmid sequence workspace",
    "longDescription": "View, annotate, and edit plasmid DNA, analyze proteins, align sequences, and design PCR and cloning workflows locally. Optional AI requests and NCBI BLAST submissions share only the context explicitly chosen for submission.",
    "copyright": "Copyright © 2026 PlasmidCraft contributors",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.3",
      "infoPlist": "file-associations/Info.plist"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installerHooks": "file-associations/windows.nsh"
      }
    },
    "resources": {
      "../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt",
      "../LICENSE": "LICENSE",
      "icons/document.icns": "document.icns",
      "icons/document.ico": "document.ico"
    },
    "fileAssociations": [
      {
        "ext": [
          "pcraft"
        ],
        "name": "PlasmidCraft.project",
        "description": "PlasmidCraft Document",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "application/x-plasmidcraft"
      },
      {
        "ext": [
          "pcprotein"
        ],
        "name": "PlasmidCraft.protein",
        "description": "PlasmidCraft Protein",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "application/x-plasmidcraft-protein"
      },
      {
        "ext": [
          "gb",
          "gbk",
          "genbank"
        ],
        "name": "PlasmidCraft.genbank",
        "description": "GenBank Sequence",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "chemical/seq-na-genbank"
      },
      {
        "ext": [
          "fa",
          "fasta",
          "fna"
        ],
        "name": "PlasmidCraft.fasta",
        "description": "FASTA Sequence",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "chemical/seq-na-fasta"
      },
      {
        "ext": [
          "faa",
          "pep"
        ],
        "name": "PlasmidCraft.protein-fasta",
        "description": "Protein Sequence",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "application/x-plasmidcraft-protein-fasta"
      },
      {
        "ext": [
          "dna"
        ],
        "name": "PlasmidCraft.dna",
        "description": "SnapGene DNA Sequence",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "application/x-snapgene-dna"
      },
      {
        "ext": [
          "ab1"
        ],
        "name": "PlasmidCraft.trace",
        "description": "Sanger Trace",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "application/x-abi-trace"
      }
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/share/mime/packages/org.plasmidcraft.desktop.xml": "file-associations/mime.xml",
          "/usr/share/icons/hicolor/512x512/mimetypes/application-x-plasmidcraft.png": "icons/document.png",
          "/usr/share/icons/hicolor/512x512/mimetypes/application-x-plasmidcraft-protein.png": "icons/document.png",
          "/usr/share/icons/hicolor/512x512/mimetypes/chemical-seq-na-genbank.png": "icons/document.png",
          "/usr/share/icons/hicolor/512x512/mimetypes/chemical-seq-na-fasta.png": "icons/document.png",
          "/usr/share/icons/hicolor/512x512/mimetypes/application-x-plasmidcraft-protein-fasta.png": "icons/document.png",
          "/usr/share/icons/hicolor/512x512/mimetypes/application-x-snapgene-dna.png": "icons/document.png",
          "/usr/share/icons/hicolor/512x512/mimetypes/application-x-abi-trace.png": "icons/document.png"
        },
        "postInstallScript": "file-associations/post-install.sh",
        "postRemoveScript": "file-associations/post-remove.sh"
      }
    }
  }
}
