{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PlasmidCraft 0.31",
  "version": "0.31.0",
  "identifier": "org.plasmidcraft.desktop",
  "build": {
    "frontendDist": "../viewer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PlasmidCraft",
        "width": 1440,
        "height": 960,
        "minWidth": 760,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Local plasmid sequence workspace",
    "longDescription": "View, annotate, and edit plasmid DNA, analyze proteins, align sequences, and design PCR and cloning workflows locally. Optional AI requests and NCBI BLAST submissions share only the context explicitly chosen for submission.",
    "copyright": "Copyright \u00a9 2026 PlasmidCraft contributors",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.3"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    },
    "resources": {
      "../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt",
      "../LICENSE": "LICENSE"
    }
  }
}
